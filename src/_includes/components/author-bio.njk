{% from "components/avatar.njk" import avatar %}
{% set currentAuthor = authors[author] %}

{% if currentAuthor %}
<section class="author-section">
    <a href="{{ currentAuthor | authorUrl }}" class="author-grid author-grid-link">
        {{ avatar(author, currentAuthor, "author-photo") }}
        <div>
            <h3>Tentang {{ author }}{% if currentAuthor.affiliation %} <span class="author-affiliation">sebagai penulis {{ currentAuthor.affiliation }}</span>{% endif %}</h3>
            <p>{{ currentAuthor.bio }}</p>
        </div>
        <span class="author-profile-cta">{% if currentAuthor.profileUrl %}Selengkapnya →{% else %}Lihat Profil →{% endif %}</span>
    </a>
</section>
{% endif %}
