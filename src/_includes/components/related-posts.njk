{# Up to 3 articles: newest in the same category first, then the newest from any category.
   The selection logic is the `relatedPosts` filter in .eleventy.js. #}
{% set related = collections.articles | relatedPosts(category, page.url) %}

{% if related.length %}
<section class="related-section">
    <h3>Bacaan Terkait</h3>
    <div class="related-grid">
        {% for post in related %}
            <div class="related-card">
                <a href="{{ post.url }}">
                    <h4>{{ post.data.title }}</h4>
                    <p>By {{ post.data.author }}</p>
                </a>
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
