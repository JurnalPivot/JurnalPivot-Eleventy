---
# Web version of DOCUMENTATION.md (in the project root).
# The content is rendered from that file at every build by the
# `documentation` global data in .eleventy.js, so never edit it here:
# edit DOCUMENTATION.md and this page follows.
# It is not linked from the menu and asks search engines not to index it.
# To stop publishing it, delete this file.
layout: base.njk
title: Dokumentasi Teknis
cssFile: docs.css
noindex: true
---

<div class="docs-layout">

    <aside class="docs-sidebar" aria-label="Daftar isi">
        <p class="docs-sidebar-label">Daftar Isi</p>
        <nav>
            <ol>
                {% for section in documentation.sections %}
                <li><a href="#{{ section.id }}">{{ section.title }}</a></li>
                {% endfor %}
            </ol>
        </nav>
    </aside>

    <article class="docs-content">
        <p class="docs-source-note">
            Halaman ini dibuat otomatis dari berkas <code>DOCUMENTATION.md</code> di repositori.
            Setiap kali situs di-build, halaman ini ikut diperbarui.
        </p>
        {{ documentation.html | safe }}
        <p class="docs-back-to-top"><a href="#">↑ Kembali ke atas</a></p>
    </article>

</div>

<script>
    // Highlight the current section in the sidebar while scrolling.
    (function () {
        var links = document.querySelectorAll('.docs-sidebar a');
        if (!links.length || !('IntersectionObserver' in window)) return;
        var byId = {};
        links.forEach(function (link) { byId[link.getAttribute('href').slice(1)] = link; });
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                links.forEach(function (l) { l.classList.remove('is-current'); });
                var link = byId[entry.target.id];
                if (link) link.classList.add('is-current');
            });
        }, { rootMargin: '0px 0px -70% 0px' });
        document.querySelectorAll('.docs-content h2[id]').forEach(function (h) { observer.observe(h); });
    })();
</script>
