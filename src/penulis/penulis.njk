---
# One profile page per author in src/_data/authors.json.
# `profileAuthors` (defined in .eleventy.js) is the list of author names,
# minus entries that have a `profileUrl` (e.g. "Redaksi"), which link elsewhere.
pagination:
  data: profileAuthors
  size: 1
  alias: authorName
layout: layouts/profile.njk
permalink: "/penulis/{{ authors[authorName].slug }}/"
eleventyComputed:
  title: "{{ authorName }}"
---
